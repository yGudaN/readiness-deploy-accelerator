{
  "name": "readiness-deploy-accelerator",
  "productName": "Readiness Deploy Accelerator",
  "version": "1.0.0",
  "private": true,
  "description": "Readiness Deploy Accelerator (Bizapp) - catalogo de solucoes COE instaladas via PowerShell",
  "author": "Bizapp",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run validar && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "validar": "node scripts/validar-modulos.mjs",
    "sincronizar": "node scripts/sincronizar-assets.mjs",
    "dist": "npm run sincronizar && npm run build && electron-builder --win",
    "dev:web": "vite --config vite.web.config.ts",
    "icone": "pwsh -NoProfile -File scripts/gerar-icone.ps1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
